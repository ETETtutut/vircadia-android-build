# Binary model formats: never diff, never re-encode, never line-ending convert.
*.fbx   binary
*.glb   binary
*.gltf  binary
*.baked binary
*.bin   binary
*.so    binary
*.apk   binary
*.aar   binary
*.jar   binary
*.jks   binary
*.keystore binary

# Qt/compiled resources
*.rcc   binary
*.qrc   text eol=lf

# Text formats this project owns
*.json  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.java  text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.gradle text eol=lf
*.xml   text eol=lf

# Keep generated world JSON diffable in review.
world/*.json text eol=lf
